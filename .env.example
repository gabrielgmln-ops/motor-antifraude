# .env.example
# Copie para ".env" e ajuste os valores. O arquivo .env NUNCA deve ser versionado.

# --- PostgreSQL ---
POSTGRES_USER=antifraude
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=antifraude
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICO_TRANSACOES=transacoes.eventos
KAFKA_TOPICO_DECISOES=antifraude.decisoes
KAFKA_GRUPO_CONSUMIDOR=motor-antifraude

# --- Regras ---
# "mais de N transações em M minutos"
REGRA_RAJADA_MAX_TRANSACOES=4
REGRA_RAJADA_JANELA_MINUTOS=10
# Mínimo de transações anteriores para o percentil 99 da conta ser confiável
REGRA_PERCENTIL_MIN_HISTORICO=20
# Horário de risco (hora local, início inclusivo, fim exclusivo)
REGRA_MADRUGADA_INICIO=0
REGRA_MADRUGADA_FIM=5
FUSO_HORARIO=America/Sao_Paulo

# --- Modelo ---
CAMINHO_MODELO=modelos/isolation_forest.joblib
